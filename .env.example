# Copy to .env (gitignored). Only relay/server.js reads it; the key never reaches a browser.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional
# PORT=8788
# Sites allowed to call the relay from a page, comma separated, such as https://you.github.io
# ALLOWED_ORIGINS=
# Host names the relay answers to behind an HTTPS proxy, comma separated; each also counts as
# an allowed origin, so a copy of the site served there can use it
# PUBLIC_HOSTS=
# Input tokens per UTC day the key may spend. A decision is about 800 input tokens, so
# 20000000 is about 25,000 decisions, or about $0.84 at $0.042 per million tokens. 0: no limit.
# DAILY_TOKEN_BUDGET=0
# Decisions per minute per visitor address
# PER_MINUTE=20
# 1 when a reverse proxy sets X-Real-IP
# TRUST_PROXY=0
